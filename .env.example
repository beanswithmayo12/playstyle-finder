# Copy to .env and fill in real values. Docs: docs/01-architecture.md

# ── Database (Neon Postgres, pooled connection string) ──
DATABASE_URL="postgresql://user:password@host/playstyle?sslmode=require"

# ── Auth (Clerk → dashboard.clerk.com) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."   # Clerk dashboard → Webhooks → /api/webhooks/clerk

# ── AI (console.anthropic.com) ──
ANTHROPIC_API_KEY="sk-ant-..."
# Set to "1" to run WITHOUT any AI calls (demo mode: deterministic metrics
# from quiz keywords, template scouting reports, canned video events).
MOCK_AI=""

# ── Payments (Stripe, test mode until launch) ──
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."  # stripe listen --forward-to localhost:3000/api/stripe/webhook
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_MEMBERSHIP_PRICE_ID=""      # recurring Price id for the $12/mo membership
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # absolute base for checkout redirect URLs

# ── Analytics (PostHog — optional; analytics no-op when unset) ──
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── Email (Resend — Phase 2+) ──
RESEND_API_KEY=""

# ── Storage & jobs (Phase 4: video pipeline) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="playstyle-videos"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
INNGEST_DEV="1"   # local dev: point the SDK at `npx inngest-cli dev`; remove in production
